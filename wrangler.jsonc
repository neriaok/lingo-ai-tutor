{
  // Static hosting for the web app on Cloudflare Workers (deployed by Workers Builds on every push to main).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lingo",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
